# Backend environment variables
# Copy this file to .env and fill values.

# Supabase project URL (Settings -> API -> Project URL)
SUPABASE_URL=

# Supabase service role key (Settings -> API -> service_role key)
# Keep this secret: NEVER put it in frontend or commit it.
SUPABASE_SERVICE_KEY=

# Backend port to run on
PORT=3000

# Resend API key for meeting email notifications
                                                                                                                                                                                                                                                                                                                                         ://resend.com and set a valid API key here.
RESEND_API_KEY=
# Optional email address to send from. Must be a verified sender/domain in Resend.
SEND_EMAIL_FROM=The X Company <onboarding@resend.dev>

# Fast2SMS API key for meeting SMS notifications
FAST2SMS_API_KEY=
# Optional sender ID for Fast2SMS (default: FSTSMS)
FAST2SMS_SENDER_ID=FSTSMS
# Optional route name for Fast2SMS (default: v3)
FAST2SMS_ROUTE=v3
